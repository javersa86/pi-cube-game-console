{
  "name": "game-console-menu",
  "version": "1.0.6",
  "main": "electron/main.js",
  "scripts": {
    "dev": "./node_modules/.bin/vite",
    "build": "./node_modules/.bin/vite build",
    "electron": "./node_modules/.bin/electron .",
    "start": "./node_modules/.bin/concurrently \"npm run dev\" \"npm run electron\"",
    "package:local": "vite build && electron-builder --linux --x64",
    "package:pi": "vite build && electron-builder --linux --armv7l"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.1",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "build": {
    "appId": "com.yourname.game-console-menu",
    "productName": "Game-Console-Menu",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "public/assets/sounds",
        "to": "sounds"
      },
      {
        "from": "public/assets/pictures",
        "to": "pictures"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "armv7l"
          ]
        }
      ]
    }
  }
}
